# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_CLOUD=aws
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=conference-calls
PINECONE_SUMMARIES_INDEX_NAME=conference-summaries

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
# For Railway: Use the DATABASE_URL provided by Railway
DATABASE_URL=postgresql://user:password@localhost:5432/conference_db
DATABASE_ECHO=false

# Agent Settings
MAX_ITERATIONS=5
DEFAULT_TOP_K=10
MIN_RELEVANCE_SCORE=0.7

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
